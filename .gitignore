# Git 发布项目主体与比赛官方 input；本地测试、分析、缓存及实验记录不跟踪。
/*
!/.env.example
!/.gitattributes
!/.gitignore
!/README.md
!/pyproject.toml
!/uv.lock

# 比赛官方数据包；该目录中的自定义输入、预测结果和缓存仍不跟踪。
!/input/
/input/*
!/input/metadata.csv
!/input/test_Q.csv
!/input/train_QA.csv
!/input/Score.py
!/input/CONTRIBUTE_QUESTIONS.md
!/input/WRITEUP_TEMPLATE.md

# 只发布建库和预测入口。
!/scripts/
/scripts/*
!/scripts/build_index.py
!/scripts/predict.py

# 只发布运行管线；新增核心文件时同步更新此清单。
!/src/
/src/*
!/src/wattbot/
/src/wattbot/*
!/src/wattbot/__init__.py
!/src/wattbot/generate.py
!/src/wattbot/index.py
!/src/wattbot/ingest.py
!/src/wattbot/models.py
!/src/wattbot/retrieve.py
